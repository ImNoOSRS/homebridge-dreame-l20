{
  "pluginAlias": "DreameL20",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "required": ["name", "email", "password"],
    "properties": {
      "name": { "title": "Name", "type": "string", "default": "Dreame L20 Ultra" },
      "email": { "title": "Dreame Home Email", "type": "string", "format": "email" },
      "password": { "title": "Dreame Home Password", "type": "string", "format": "password" },
      "region": { "title": "Region", "type": "string", "default": "eu", "enum": ["eu", "us", "cn", "ru", "sg", "in", "de", "tw"] },
      "deviceId": { "title": "Device DID (optional)", "type": "string" },

      "rooms": {
        "title": "Custom Rooms",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "title": "Room Name" },
            "segmentId": { "type": "integer", "title": "Segment ID" },
            "mode": { 
              "type": "string", 
              "enum": ["vacuum", "mop", "vacuum_mop"], 
              "default": "vacuum_mop" 
            },
            "suction": { "type": "integer", "minimum": 1, "maximum": 4, "default": 2 },
            "water": { "type": "integer", "minimum": 0, "maximum": 3, "default": 2 }
          },
          "required": ["name", "segmentId"]
        }
      }
    }
  }
}