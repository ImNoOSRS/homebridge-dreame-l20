{
  "pluginAlias": "DreameL20",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "required": ["name", "email", "password"],
    "additionalProperties": false,
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Dreame L20 Ultra"
      },
      "email": {
        "title": "Dreame Home Email",
        "type": "string",
        "format": "email"
      },
      "password": {
        "title": "Dreame Home Password",
        "type": "string",
        "format": "password"
      },
      "region": {
        "title": "Region",
        "type": "string",
        "default": "eu",
        "enum": ["eu", "us", "cn", "ru", "sg", "in", "de", "tw"]
      },
      "deviceId": {
        "title": "Device DID (optional)",
        "type": "string",
        "description": "Leave empty to auto-detect"
      }
    }
  }
}